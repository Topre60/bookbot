{
  "name": "inkling-desktop",
  "productName": "Inkling",
  "version": "0.2.0",
  "description": "Prose, screenplays and poems, with a cast bar that writes dialogue for you.",
  "author": "Topre60",
  "repository": {
    "type": "git",
    "url": "https://github.com/Topre60/bookbot.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.topre60.inkling",
    "productName": "Inkling",
    "copyright": "Topre60",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "inkling",
        "name": "Inkling document",
        "role": "Editor"
      },
      {
        "ext": "fountain",
        "name": "Fountain screenplay",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "Inkling-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Inkling"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Inkling",
      "artifactName": "Inkling-${version}-windows-${arch}-setup.${ext}"
    }
  }
}
